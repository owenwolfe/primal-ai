{
  "openapi": "3.1.0",
  "info": {
    "title": "Primal API",
    "version": "1.0.0",
    "description": "Stateless, English ingredient preference evaluation. Rules are draft product preferences, not health claims. Photos never leave the device."
  },
  "paths": {
    "/api/v1/evaluations": {
      "post": {
        "operationId": "evaluateIngredients",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation produced, including partial matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 32 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid ingredient list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service and rule bundle loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EvaluationRequest": {
        "type": "object",
        "properties": {
          "ingredientText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "ingredientText"
        ],
        "additionalProperties": false
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1"
          },
          "rulesVersion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unrecognized"
            ]
          },
          "rating": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "aligned",
              "review",
              null
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "unmatchedIngredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notice": {
            "type": "string"
          },
          "methodology": {
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "rulesVersion",
          "status",
          "rating",
          "findings",
          "unmatchedIngredients",
          "notice",
          "methodology"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "properties": {
                "rating": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "rating": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Known values: whole_food, culinary, added_sweetener, additive, unknown. Clients must handle future categories."
          },
          "explanation": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "name",
          "category",
          "explanation",
          "basis"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "serviceVersion": {
            "type": "string"
          },
          "rulesVersion": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "serviceVersion",
          "rulesVersion"
        ]
      }
    }
  }
}
